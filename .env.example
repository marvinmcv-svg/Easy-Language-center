# Easy Learning Center — environment variables
# Copy this file to `.env` and fill in real values.

# ---- Database (Prisma / SQLite) ----
# SQLite path. Prisma resolves a relative `file:` path against the `prisma/`
# directory, so an ABSOLUTE path is the most predictable choice — especially
# for the standalone production server, whose working directory differs.
#   Local dev example:  file:/absolute/path/to/Easy-Language-center/db/custom.db
#   Relative (from prisma/): file:../db/custom.db
# To use PostgreSQL instead, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and set a postgres:// URL here.
DATABASE_URL="file:./db/custom.db"

# ---- Auth ----
# REQUIRED in production. Signs admin session cookies. If unset (or left as the
# dev default) in production, the app refuses to start.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=""

# ---- Seed admin (used only by `bun run scripts/seed.ts`) ----
# Defaults shown; override to create a different initial admin.
ADMIN_EMAIL="admin@easylearning.com"
ADMIN_PASSWORD="elc-admin-2026"
ADMIN_NAME="Administrador ELC"

# ---- AI chat (optional) ----
# The "Shirley" chat widget uses an AI provider. If no provider is configured,
# the widget still works but replies with a helpful message pointing users to
# WhatsApp. See src/app/api/chat/route.ts.
# ANTHROPIC_API_KEY=""
